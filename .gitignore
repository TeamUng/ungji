# -----------------------------------------------------------------------------
node_modules/
.npm-cache/
.npm/
.pnp.*
.yarn/cache
.yarn/install-state.gz
.next/
.nuxt/
out/
.parcel-cache/
.turbo/
.vite/

# -----------------------------------------------------------------------------
# IDE / Editor
# -----------------------------------------------------------------------------
# JetBrains (PyCharm, IntelliJ, WebStorm)
.idea/
*.iml

# VS Code — ignore personal state, keep shared config
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.\#*

# -----------------------------------------------------------------------------
# OS files
# -----------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux
.fuse_hidden*
.directory
.Trash-*
.nfs*

