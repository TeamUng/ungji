          "turn": 2,
          "scenario_label": "TP3 exit prevention simulated student follow-up",
          "must_include_any": ["좋아", "조금", "한 문제", "마무리", "2문제"],
          "must_not_include": ["공부 관련 이야기만", "도와드리기 어렵", "다시 물어봐", "같이 풀어", "힌트"]
        },
        {
          "touchpoint": "tp5",
