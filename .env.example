# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO

## --- Logging ---
# --- Langsmith ---
LANGSMITH_API_KEY=your-key-here
## --- Better Stack / Logtail (all log levels) ---
LOGTAIL_SOURCE_TOKEN=your-key-here
LOGTAIL_HOST=https://s2393620.eu-fsn-3.betterstackdata.com
# --- Discord webhook (ERROR and CRITICAL only) ---
DISCORD_WEBHOOK_URL=your-key-here

## --- LLM ---
# 운영 LLM 은 OpenRouter 를 통해 호출.
# 모델 비교 실험 결과(2026-04-29) motivator + helper 분리 구조 채택.
#   - motivator (TP1·2·3·5): openai/gpt-5.4-mini
#   - helper (TP4):          google/gemini-2.5-flash
# 자세한 근거: scripts/results/model_comparison/2026-04-29/FINAL_REPORT.md

# --- OpenRouter (운영 필수) ---
OPENROUTER_API_KEY=your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# 모델 ID 는 https://openrouter.ai/models 카탈로그 기준.
# 환경별로 override 가능 (미설정 시 app/core/config.py 의 default 사용).
MOTIVATOR_MODEL=openai/gpt-5.4-mini
HELPER_MODEL=google/gemini-2.5-flash
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60

# --- Upstage (모델 비교 실험 시 solar-pro2 직접 호출용. 운영에선 미사용) ---
UPSTAGE_API_KEY=your-key-here
UPSTAGE_BASE_URL=https://api.upstage.ai/v1/solar
# --- Google Gemini (Gemini API 직접 호출용. 운영은 OpenRouter 경유라 미사용) ---
GOOGLE_API_KEY=your-key-here

## --- DB ---
# --- Supabase ---
SUPABASE_URL=https://kkqvvbehqaifsnkcchix.supabase.co
SUPABASE_ANON_KEY=your-key-here
SUPABASE_SERVICE_ROLE_KEY=your-key-here
